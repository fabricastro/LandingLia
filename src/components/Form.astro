---
const RECAPTCHA_SITE_KEY = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY;
---

<section class="flex flex-col items-center py-16" id="contacto">
  <h2 class="text-4xl font-medium text-center tracking-widest uppercase mb-8 text-primary-default">
    Contacto
  </h2>
  
  <!-- Párrafo responsive con mejor estructura -->
  <p class="text-[18px] md:text-[24px] font-textos text-center mb-12 mx-10 md:mx-20 lg:mx-[250px] 2xl:mx-[500px] text-primary-default">
    Ya seas profesional o aficionado, aquí encontrarás información,
    asesoramiento <span class="hidden xl:inline"><br /></span>
    y selecciones especiales que despertarán tus sentidos y harán
    inolvidable cada experiencia.
  </p>
  
  <form id="contactForm" class="w-full max-w-4xl px-8 space-y-6 text-lg" novalidate>
    <!-- Fila de Nombre y Email -->
    <div class="flex flex-col md:flex-row md:space-x-4 space-y-6 md:space-y-0">
      <div class="flex-1">
        <label for="name" class="sr-only">Nombre</label>
        <input
          placeholder="Nombre"
          id="name"
          name="name"
          type="text"
          class="w-full border-b-2 border-secondary-texto uppercase text-secondary-texto placeholder:text-secondary-texto focus:outline-none focus:border-gray-700 transition-colors p-2 bg-[#efebe8] px-[10px]"
          required
          aria-label="Nombre"
          aria-required="true"
        />
        <span class="error-message text-red-600 text-sm mt-1 hidden" id="name-error"></span>
      </div>
      <div class="flex-1">
        <label for="email" class="sr-only">Correo electrónico</label>
        <input
          placeholder="E-mail"
          id="email"
          name="email"
          type="email"
          class="w-full border-b-2 border-secondary-texto uppercase text-secondary-texto placeholder:text-secondary-texto focus:outline-none focus:border-gray-700 transition-colors p-2 bg-[#efebe8] px-[10px]"
          required
          aria-label="Correo electrónico"
          aria-required="true"
        />
        <span class="error-message text-red-600 text-sm mt-1 hidden" id="email-error"></span>
      </div>
    </div>

    <!-- Número de Contacto -->
    <div>
      <label for="phone" class="sr-only">Número de contacto</label>
      <input
        placeholder="Número de Contacto"
        id="phone"
        name="phone"
        type="tel"
        class="w-full border-b-2 border-secondary-texto uppercase text-secondary-texto placeholder:text-secondary-texto focus:outline-none focus:border-gray-700 transition-colors p-2 bg-[#efebe8] px-[10px]"
        required
        aria-label="Número de contacto"
        aria-required="true"
      />
      <span class="error-message text-red-600 text-sm mt-1 hidden" id="phone-error"></span>
    </div>

    <!-- Mensaje -->
    <div>
      <label for="message" class="sr-only">Mensaje</label>
      <textarea
        placeholder="Mensaje"
        id="message"
        name="message"
        rows="4"
        class="w-full border-b-2 border-secondary-texto uppercase text-secondary-texto placeholder:text-secondary-texto focus:outline-none focus:border-gray-700 transition-colors p-2 bg-[#efebe8] px-[10px] resize-none"
        required
        aria-label="Mensaje"
        aria-required="true"></textarea>
      <span class="error-message text-red-600 text-sm mt-1 hidden" id="message-error"></span>
    </div>

    <!-- reCAPTCHA v3 se ejecuta automáticamente en segundo plano, no requiere elemento visible -->

    <!-- Botón Enviar -->
    <div class="flex justify-center text-primary-default">
      <button
        type="submit"
        class="py-2 text-base font-semibold tracking-widest uppercase border-b-2 border-primary-default transition-colors flex items-center justify-center hover:border-gray-700 focus:outline-none focus:ring-2 focus:ring-primary-default focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed"
        id="submitButton"
        aria-label="Enviar formulario"
      >
        <span id="buttonText">Enviar</span>
        <span
          id="buttonLoader"
          class="ml-2 w-4 h-4 border-2 border-t-transparent border-primary-default rounded-full animate-spin hidden"
          aria-hidden="true"
        ></span>
      </button>
    </div>
  </form>

  <!-- Mensajes de estado -->
  <div 
    id="statusMessage" 
    class="mt-10 text-lg text-center hidden"
    role="alert"
    aria-live="polite"
    aria-atomic="true"
  ></div>
</section>

<style>
  /* Loader Animación */
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  
  .animate-spin {
    animation: spin 0.8s linear infinite;
  }

  /* Mensajes */
  #statusMessage.success {
    margin-top: 40px;
    color: #2b4437;
    text-align: center;
    padding: 0 10px;
  }
  
  #statusMessage.error {
    margin-top: 40px;
    color: #a98e6b;
    text-align: center;
    padding: 0 10px;
  }
  
  /* Focus visible para accesibilidad */
  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid #2b4437;
    outline-offset: 2px;
  }
</style>

<!-- Google reCAPTCHA v3 -->
<script is:inline src={`https://www.google.com/recaptcha/api.js?render=${RECAPTCHA_SITE_KEY}`}></script>

<script define:vars={{ recaptchaSiteKey: RECAPTCHA_SITE_KEY }}>
  // Esperar a que el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    const contactForm = document.getElementById("contactForm");
    const submitButton = document.getElementById("submitButton");
    const buttonText = document.getElementById("buttonText");
    const buttonLoader = document.getElementById("buttonLoader");
    const statusMessage = document.getElementById("statusMessage");

    // Elementos de validación
    const nameInput = document.getElementById("name");
    const emailInput = document.getElementById("email");
    const phoneInput = document.getElementById("phone");
    const messageInput = document.getElementById("message");

    // Variable para controlar si estamos enviando el formulario
    let isSubmitting = false;
    
    // Funciones de validación
    const validateName = (name) => {
      const trimmedName = name.trim();
      if (!trimmedName) return "El nombre es requerido";
      if (trimmedName.length < 2) return "El nombre debe tener al menos 2 caracteres";
      if (trimmedName.length > 50) return "El nombre no puede exceder 50 caracteres";
      return null;
    };
    
    const validateEmail = (email) => {
      const trimmedEmail = email.trim();
      if (!trimmedEmail) return "El correo electrónico es requerido";
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(trimmedEmail)) return "Ingrese un correo electrónico válido";
      return null;
    };
    
    const validatePhone = (phone) => {
      const trimmedPhone = phone.trim();
      if (!trimmedPhone) return "El número de contacto es requerido";
      // Permitir números con espacios, guiones y paréntesis
      const phoneRegex = /^[\d\s\-\(\)\+]+$/;
      if (!phoneRegex.test(trimmedPhone)) return "Ingrese un número de teléfono válido";
      if (trimmedPhone.replace(/\D/g, '').length < 8) return "El número debe tener al menos 8 dígitos";
      return null;
    };
    
    const validateMessage = (message) => {
      const trimmedMessage = message.trim();
      if (!trimmedMessage) return "El mensaje es requerido";
      if (trimmedMessage.length < 10) return "El mensaje debe tener al menos 10 caracteres";
      if (trimmedMessage.length > 500) return "El mensaje no puede exceder 500 caracteres";
      return null;
    };
    
    // Función para mostrar errores
    const showError = (inputId, message) => {
      const errorElement = document.getElementById(`${inputId}-error`);
      const inputElement = document.getElementById(inputId);
      if (errorElement && message) {
        errorElement.textContent = message;
        errorElement.classList.remove('hidden');
        inputElement.setAttribute('aria-invalid', 'true');
        inputElement.setAttribute('aria-describedby', `${inputId}-error`);
      }
    };
    
    // Función para limpiar errores
    const clearError = (inputId) => {
      const errorElement = document.getElementById(`${inputId}-error`);
      const inputElement = document.getElementById(inputId);
      if (errorElement) {
        errorElement.textContent = '';
        errorElement.classList.add('hidden');
        inputElement.setAttribute('aria-invalid', 'false');
        inputElement.removeAttribute('aria-describedby');
      }
    };
    
    // Validación en tiempo real
    nameInput?.addEventListener('blur', () => {
      const error = validateName(nameInput.value);
      if (error) {
        showError('name', error);
      } else {
        clearError('name');
      }
    });
    
    emailInput?.addEventListener('blur', () => {
      const error = validateEmail(emailInput.value);
      if (error) {
        showError('email', error);
      } else {
        clearError('email');
      }
    });
    
    phoneInput?.addEventListener('blur', () => {
      const error = validatePhone(phoneInput.value);
      if (error) {
        showError('phone', error);
      } else {
        clearError('phone');
      }
    });
    
    messageInput?.addEventListener('blur', () => {
      const error = validateMessage(messageInput.value);
      if (error) {
        showError('message', error);
      } else {
        clearError('message');
      }
    });
    
    // Función para mostrar mensaje de estado
    const showStatusMessage = (message, isSuccess = true) => {
      statusMessage.textContent = message;
      statusMessage.className = isSuccess ? "success mt-10 text-lg text-center" : "error mt-10 text-lg text-center";
      statusMessage.classList.remove("hidden");
      
      // Auto-ocultar después de 5 segundos
      setTimeout(() => {
        statusMessage.classList.add("hidden");
      }, 5000);
    };

    contactForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Si ya estamos enviando, no hacer nada
      if (isSubmitting) {
        return;
      }

      // Limpiar mensajes de error previos
      ['name', 'email', 'phone', 'message'].forEach(clearError);

      // Validar todos los campos
      let hasErrors = false;

      const nameError = validateName(nameInput.value);
      if (nameError) {
        showError('name', nameError);
        hasErrors = true;
      }

      const emailError = validateEmail(emailInput.value);
      if (emailError) {
        showError('email', emailError);
        hasErrors = true;
      }

      const phoneError = validatePhone(phoneInput.value);
      if (phoneError) {
        showError('phone', phoneError);
        hasErrors = true;
      }

      const messageError = validateMessage(messageInput.value);
      if (messageError) {
        showError('message', messageError);
        hasErrors = true;
      }

      if (hasErrors) {
        showStatusMessage("Por favor, corrija los errores en el formulario", false);
        return;
      }

      // Marcar que estamos enviando
      isSubmitting = true;

      // Deshabilitar botón y mostrar loader
      buttonText.textContent = "Enviando...";
      buttonLoader.classList.remove("hidden");
      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');

      try {
        // Ejecutar reCAPTCHA v3 y obtener el token
        const captchaToken = await new Promise((resolve, reject) => {
          if (window.grecaptcha && window.grecaptcha.ready) {
            window.grecaptcha.ready(() => {
              window.grecaptcha.execute(recaptchaSiteKey, { action: 'submit' })
                .then(resolve)
                .catch(reject);
            });
          } else {
            reject(new Error("reCAPTCHA no está disponible"));
          }
        });

        // Obtener datos del formulario
        const formData = new FormData(contactForm);
        const data = Object.fromEntries(formData.entries());

        // Sanitizar datos
        data.name = data.name.trim();
        data.email = data.email.trim().toLowerCase();
        data.phone = data.phone.trim();
        data.message = data.message.trim();

        // Agregar token de reCAPTCHA v3
        data.recaptchaToken = captchaToken;

        const response = await fetch("https://mailservice.technodevs.com.ar/send-email", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          showStatusMessage("¡Formulario enviado con éxito! Nos pondremos en contacto contigo pronto.", true);
          contactForm.reset();
          // Limpiar todos los estados de error
          ['name', 'email', 'phone', 'message'].forEach(clearError);
        } else if (response.status === 429) {
          showStatusMessage("Has enviado un mensaje hace poco. Por favor, inténtalo más tarde.", false);
        } else {
          const errorData = await response.json().catch(() => null);
          const errorMessage = errorData?.message || "Hubo un error al enviar el formulario. Por favor, inténtalo de nuevo.";
          showStatusMessage(errorMessage, false);
        }
      } catch (error) {
        console.error("Error al enviar el formulario:", error);

        // Mensaje de error más específico
        const errorMessage = error.message === "reCAPTCHA no está disponible"
          ? "Error al verificar el captcha. Por favor, recarga la página e inténtalo de nuevo."
          : "No se pudo conectar con el servidor. Por favor, verifica tu conexión e inténtalo más tarde.";

        showStatusMessage(errorMessage, false);
      } finally {
        buttonText.textContent = "Enviar";
        buttonLoader.classList.add("hidden");
        submitButton.disabled = false;
        submitButton.setAttribute('aria-busy', 'false');
        isSubmitting = false;
      }
    });
  });
</script>